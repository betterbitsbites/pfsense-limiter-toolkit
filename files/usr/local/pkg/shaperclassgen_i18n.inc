/*
 * shaperclassgen_i18n.inc
 *
 * Simple translation for the Shaper Class Generator. Texts are written in
 * English; if the pfSense GUI language is German (System > General Setup >
 * Language = de_DE), the German dictionary below is used.
 * Licensed under the Apache License, Version 2.0
 */

function scg_lang() {
	static $lang = null;
	if ($lang === null) {
		$l = '';
		if (function_exists('config_get_path')) {
			$l = (string)config_get_path('system/language', '');
		} else {
			global $config;
			$l = (string)($config['system']['language'] ?? '');
		}
		$lang = (stripos($l, 'de') === 0) ? 'de' : 'en';
	}
	return $lang;
}

/* Translate; further arguments are inserted with sprintf */
function scg_t($en, ...$args) {
	$s = $en;
	if (scg_lang() === 'de') {
		$d = scg_dict_de();
		if (isset($d[$en])) {
			$s = $d[$en];
		}
	}
	return $args ? vsprintf($s, $args) : $s;
}

/* Dictionary for JavaScript (empty in English) */
function scg_t_dict() {
	return scg_lang() === 'de' ? scg_dict_de() : array();
}

/* Label of a list entry, with "(extra)" for entries not in the wizard */
function scg_label($d) {
	return $d['label'] . (!empty($d['x']) ? ' (' . scg_t('extra') . ')' : '');
}

/* Common tab bar of all package pages */
function scg_tabs($active) {
	$tabs = array();
	$tabs[] = array(gettext("By Interface"), false, "firewall_shaper.php");
	$tabs[] = array(gettext("Limiters"), false, "firewall_shaper_vinterface.php");
	$tabs[] = array(scg_t('Class Generator'), $active === 'classgen', "firewall_shaper_classgen.php");
	$tabs[] = array("Autorate", $active === 'autorate', "firewall_shaper_autorate.php");
	$tabs[] = array("Limiter Live", $active === 'live', "status_limiters_live.php");
	$tabs[] = array("Speedtest", $active === 'speedtest', "status_speedtest.php");
	$tabs[] = array("Limiter Info", false, "diag_limiter_info.php");
	display_top_tabs($tabs);
}

