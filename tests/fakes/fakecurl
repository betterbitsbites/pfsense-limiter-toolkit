#!/usr/bin/env python3
import sys, time, os
a=sys.argv[1:]; secs=float(a[a.index('-m')+1]); up='-T' in a
rate=float(os.environ.get('FAKE_UP' if up else 'FAKE_DOWN', '3e6' if up else '150e6'))
if os.environ.get('FAKE_FAIL'): print("SCG 0 000"); sys.exit(7)
size=25*1024*1024 if up else 1e9
t=min(secs, size*8/rate); time.sleep(t)
b=int(size) if t<secs else int(rate*t/8)
print("HTTP/2 200\r\ncf-ray: 8abc123def-FRA\r\n\r\n")
print("\nSCG %d %d" % (b, 200 if (t<secs or not up) else 0))
sys.exit(0 if t<secs else 28)
